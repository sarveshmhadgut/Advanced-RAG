# Environment Configuration Template (.env.example)
# Copy this file to .env and populate with your actual credentials:
#   cp .env.example .env


# Google Gemini
# Get your API key from Google AI Studio: https://aistudio.google.com/
GOOGLE_API_KEY="your-google-api-key-here"

# LangChain & LangSmith
# Get your API key from LangSmith: https://smith.langchain.com/
LANGCHAIN_API_KEY="your-langchain-api-key-here"

# Enable/disable tracing in LangSmith (true / false)
LANGSMITH_TRACING_V2=true

# Project name under which traces will be logged in LangSmith
LANGSMITH_PROJECT="advancedrag"

# Optional: LangSmith endpoint (default: https://api.smith.langchain.com)
# For APAC region, use: https://apac.api.smith.langchain.com
LANGSMITH_ENDPOINT="https://apac.api.smith.langchain.com"
